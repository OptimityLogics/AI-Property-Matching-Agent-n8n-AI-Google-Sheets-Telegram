        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ systemInstruction: { parts: [{ text: \"Extract real-estate requirements. Return JSON keys: buyer_name, phone, email, city, localities, budget_min_inr, budget_max_inr, bhk, min_area_sqft, amenities, possession, property_type. Convert lakh/crore to INR. Do not invent values.\" }] }, contents: [{ role: 'user', parts: [{ text: $json.message.text }] }], generationConfig: { responseMimeType: 'application/json' } }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "eaabae22-27fb-4de0-bcf2-82588dcda573",
      "name": "Gemini: Extract Requirements",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nlet parsed = {};\ntry { parsed = JSON.parse(raw.candidates?.[0]?.content?.parts?.[0]?.text || '{}'); } catch {}\nconst tg = $('Telegram Trigger').first().json;\nconst msg = tg.message || {};\nconst req = { ...parsed, city: parsed.city || 'Ahmedabad', localities: parsed.localities || [], bhk: parsed.bhk || [], amenities: parsed.amenities || [], possession: parsed.possession || 'any', property_type: parsed.property_type || 'any', buyer_name: parsed.buyer_name || msg.from?.first_name || '', chat_id: msg.chat?.id, original_message: msg.text || '' };\nreq.needs_more_info = !(req.budget_max_inr || req.bhk.length || req.localities.length);\nreq.requirement_summary = [req.bhk.length ? req.bhk.join('/') + ' BHK' : '', req.property_type !== 'any' ? req.property_type : 'property', 'in ' + (req.localities.length ? req.localities.join('/') + ', ' : '') + req.city, req.budget_max_inr ? 'under ₹' + Number(req.budget_max_inr).toLocaleString('en-IN') : ''].filter(Boolean).join(' ');\nreturn [{json:req}];"
      },
