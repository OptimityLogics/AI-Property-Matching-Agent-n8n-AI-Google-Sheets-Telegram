      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const d = $input.first().json; const norm = $('Normalize, Filter & Rank').first().json; const req = norm.req; const matches = norm.matches;\nlet g = {}; try { g = JSON.parse(d.candidates?.[0]?.content?.parts?.[0]?.text || '{}'); } catch {}\nconst cards = matches.map((m,i)=>[(i+1)+'. '+m.title+' (match '+m.score+'/100)',m.locality?'Location: '+m.locality:'',m.price?'Price: '+m.price:'',m.bhk?'Configuration: '+m.bhk:'',m.url?'Link: '+m.url:''].filter(Boolean).join('\\n')).join('\\n\\n');\nconst reply = 'Hello '+(req.buyer_name || '')+'! '+(g.reply_intro || 'Here are the best matches I found.')+'\\n\\nSearched: '+req.requirement_summary+'\\n\\nTop matches:\\n'+cards;\nreturn [{json:{timestamp:new Date().toISOString(),chat_id:req.chat_id,buyer_name:req.buyer_name||'',phone:req.phone||'',email:req.email||'',requirement_text:req.requirement_summary,city:req.city,localities:(req.localities||[]).join(', '),budget_max_inr:req.budget_max_inr||'',bhk:(req.bhk||[]).join('/'),amenities:(req.amenities||[]).join(', '),possession:req.possession,top_matches:matches.map(m=>m.title+' | '+m.price+' | '+m.locality+' | score '+m.score).join(' || '),top_match_urls:matches.map(m=>m.url).join(' , '),followup_draft:g.followup_message||'',status:'New - awaiting sales approval',reply:reply.slice(0,3800)}}];"
      },
