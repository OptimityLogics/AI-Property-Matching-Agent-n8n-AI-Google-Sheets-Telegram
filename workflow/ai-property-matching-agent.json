        "jsonBody": "={{ JSON.stringify({ systemInstruction: { parts: [{ text: \"You are a property advisor. Return JSON with reply_intro and followup_message. Do not claim availability is confirmed.\" }] }, contents: [{ role: 'user', parts: [{ text: 'REQUIREMENT: ' + JSON.stringify($json.req) + ' MATCHES: ' + JSON.stringify($json.matches) }] }], generationConfig: { responseMimeType: 'application/json' } }) }}",
