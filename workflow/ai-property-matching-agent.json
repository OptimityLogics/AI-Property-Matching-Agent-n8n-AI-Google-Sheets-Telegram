    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/haketa~housing-scraper/run-sync-get-dataset-items",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_APIFY_API_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ cities: [ $('Validate Requirements').first().json.city.toLowerCase().trim() ], service: 'buy', maxItems: 100 }) }}",
        "options": {
          "timeout": 240000
        }
      },
      "id": "bc19d744-17f5-422e-a7ab-5901e1ca655a",
      "name": "Apify: Fetch Live Listings",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        5344,
        2256
      ],
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const req = $('Validate Requirements').first().json;\nconst items = $input.all().map(i => i.json).filter(o => o && !o.error && (o.title || o.priceDisplay || o.priceMin));\nconst wantLoc = (req.localities || []).map(x => String(x).toLowerCase());\nconst out = [];\nfor (const it of items) {\n const blob = JSON.stringify(it).toLowerCase(); const sub = String(it.subtitle || '');\n const nums = /bhk/i.test(sub) ? [...sub.split(/bhk/i)[0].matchAll(/\\d+(?:\\.\\d+)?/g)].map(m => parseFloat(m[0])) : [];\n const bhks = [...new Set(nums.flatMap(n => [Math.floor(n), Math.ceil(n)]))];\n const pmin = Number(it.priceMin) || null; const pmax = Number(it.priceMax) || pmin;\n if (req.bhk.length && !req.bhk.some(b => bhks.includes(b))) continue;\n if (req.budget_max_inr && pmin && pmin > req.budget_max_inr * 1.1) continue;\n if (wantLoc.length && !wantLoc.some(l => blob.includes(l))) continue;\n let score = (!req.budget_max_inr ? 15 : pmax && pmax <= req.budget_max_inr ? 30 : pmin && pmin <= req.budget_max_inr ? 22 : 10) + (wantLoc.length ? 25 : 10) + (req.bhk.length ? 20 : 15) + 10;\n out.push({title:it.title || 'Property',locality:[it.address,it.detailedAddress].filter(Boolean).join(' | '),bhk:sub,price:it.priceDisplay || (pmin ? String(pmin) : ''),property_type:it.propertyType || '',seller:it.sellerName || '',posted:it.postedDate || '',url:it.url || '',verified:!!it.isVerified,score});\n}\nout.sort((a,b)=>b.score-a.score);\nreturn [{json:{req,matches:out.slice(0,5),total_found:out.length,scanned:items.length}}];"
      },
