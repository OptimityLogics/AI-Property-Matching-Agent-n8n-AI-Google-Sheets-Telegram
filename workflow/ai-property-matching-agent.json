      "id": "b0604fe9-ae1a-4460-8291-8fceaad3eeee",
      "name": "Gemini: Explain + Follow-up Draft",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        6224,
        2272
      ],
