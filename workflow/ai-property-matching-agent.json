        "message": "={{ 'Requirement: ' + $('Prepare Lead Row').first().json.requirement_text + '\\n\\nTop matches: ' + $('Prepare Lead Row').first().json.top_matches + '\\n\\nDRAFT FOLLOW-UP (review before sending to buyer):\\n' + $('Prepare Lead Row').first().json.followup_draft }}",
